# Frontend env vars. Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored automatically by Next.js (see frontend/.gitignore).
#
# These vars are READ AT BUILD TIME by Next.js. After changing, rebuild:
#   cd frontend && npm run build && PORT=3001 npm run start

# Mapbox public token. Used by the city page CityMap component.
# Public tokens (pk.*) are safe to expose in client-side code.
# Get one at https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=
